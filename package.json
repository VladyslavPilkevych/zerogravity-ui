{
    "name": "zerogravity-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Motion-first React components: particle fields, scroll framing, carousels and display type.",
    "keywords": [
        "react",
        "nextjs",
        "components",
        "animation",
        "canvas",
        "cursor",
        "scroll",
        "carousel",
        "particles"
    ],
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VladyslavPilkevych/zerogravity-ui.git"
    },
    "bugs": {
        "url": "https://github.com/VladyslavPilkevych/zerogravity-ui/issues"
    },
    "homepage": "https://github.com/VladyslavPilkevych/zerogravity-ui#readme",
    "sideEffects": [
        "**/*.css"
    ],
    "packageManager": "pnpm@10.16.1",
    "engines": {
        "node": ">=20",
        "pnpm": ">=10"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "dependencies": {
        "next": "^15.5.23"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.15.3",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^6.1.1",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.67.0",
        "vitest": "^3.2.7"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp"
        ],
        "overrides": {
            "postcss@<8.5.23": ">=8.5.23",
            "nanoid@<3.3.18": ">=3.3.18",
            "sharp@<0.35.0": ">=0.35.0"
        }
    }
}
