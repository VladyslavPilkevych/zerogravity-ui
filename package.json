{
    "name": "zerogravity-ui",
    "version": "0.1.0",
    "private": true,
    "description": "Motion-first React components: particle fields, animated borders, illustrated scenes, scroll framing, carousels and display type.",
    "keywords": [
        "react",
        "nextjs",
        "components",
        "animation",
        "canvas",
        "cursor",
        "scroll",
        "carousel",
        "particles",
        "border",
        "svg",
        "pointer",
        "transition"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VladyslavPilkevych/zerogravity-ui.git"
    },
    "bugs": {
        "url": "https://github.com/VladyslavPilkevych/zerogravity-ui/issues"
    },
    "homepage": "https://github.com/VladyslavPilkevych/zerogravity-ui#readme",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./antigravity": {
            "types": "./dist/antigravity/index.d.ts",
            "import": "./dist/antigravity/index.js"
        },
        "./aperture": {
            "types": "./dist/aperture/index.d.ts",
            "import": "./dist/aperture/index.js"
        },
        "./diorama": {
            "types": "./dist/diorama/index.d.ts",
            "import": "./dist/diorama/index.js"
        },
        "./elemental": {
            "types": "./dist/elemental/index.d.ts",
            "import": "./dist/elemental/index.js"
        },
        "./grid-trail": {
            "types": "./dist/grid-trail/index.d.ts",
            "import": "./dist/grid-trail/index.js"
        },
        "./kern": {
            "types": "./dist/kern/index.d.ts",
            "import": "./dist/kern/index.js"
        },
        "./lodestone": {
            "types": "./dist/lodestone/index.d.ts",
            "import": "./dist/lodestone/index.js"
        },
        "./meadow": {
            "types": "./dist/meadow/index.d.ts",
            "import": "./dist/meadow/index.js"
        },
        "./overprint": {
            "types": "./dist/overprint/index.d.ts",
            "import": "./dist/overprint/index.js"
        },
        "./pointer-fx": {
            "types": "./dist/pointer-fx/index.d.ts",
            "import": "./dist/pointer-fx/index.js"
        },
        "./reel": {
            "types": "./dist/reel/index.d.ts",
            "import": "./dist/reel/index.js"
        },
        "./ricochet": {
            "types": "./dist/ricochet/index.d.ts",
            "import": "./dist/ricochet/index.js"
        },
        "./scroll-stack": {
            "types": "./dist/scroll-stack/index.d.ts",
            "import": "./dist/scroll-stack/index.js"
        },
        "./split-flap": {
            "types": "./dist/split-flap/index.d.ts",
            "import": "./dist/split-flap/index.js"
        },
        "./stencil": {
            "types": "./dist/stencil/index.d.ts",
            "import": "./dist/stencil/index.js"
        },
        "./tessera": {
            "types": "./dist/tessera/index.d.ts",
            "import": "./dist/tessera/index.js"
        },
        "./trailing-cursor": {
            "types": "./dist/trailing-cursor/index.d.ts",
            "import": "./dist/trailing-cursor/index.js"
        },
        "./vellum": {
            "types": "./dist/vellum/index.d.ts",
            "import": "./dist/vellum/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@10.16.1",
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:lib": "tsup",
        "start": "next start",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --project=unit",
        "test:watch": "vitest --project=unit",
        "test:browser": "vitest run --project=storybook",
        "test:e2e": "playwright test",
        "test:consumer": "node scripts/consumer-test.mjs",
        "check:package": "node scripts/check-package.mjs",
        "chromatic": "chromatic",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:browser",
        "release:check": "pnpm check && pnpm build:lib && pnpm check:package && pnpm test:consumer",
        "prepack": "pnpm build:lib"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-vitest": "^10.5.8",
        "@storybook/react-vite": "^10.5.8",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/node": "^22.15.3",
        "@types/react": "^19.1.9",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "chromatic": "^18.2.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^6.1.1",
        "jsdom": "^30.0.1",
        "lefthook": "^2.1.10",
        "next": "^15.5.23",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "publint": "^0.3.23",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "storybook": "^10.5.8",
        "tsup": "^8.5.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lefthook",
            "sharp"
        ],
        "overrides": {
            "postcss@<8.5.23": ">=8.5.23",
            "nanoid@<3.3.18": ">=3.3.18",
            "sharp@<0.35.0": ">=0.35.0",
            "esbuild@<0.28.1": ">=0.28.1"
        }
    }
}
