{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "incremental": false,
        "jsx": "react-jsx",
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "src/lib"
    },
    "include": ["src/lib/**/*.ts", "src/lib/**/*.tsx"],
    "exclude": [
        "src/lib/**/*.test.ts",
        "src/lib/**/*.test.tsx",
        "src/lib/**/*.stories.ts",
        "src/lib/**/*.stories.tsx",
        "src/lib/experimental/**"
    ]
}
